#!/bin/bash
# kitty-enhance codex wrapper
# Ensures Codex tab notifications still work in Kitty shells that do not source ~/.bashrc.

debug() {
    [ "${CLAUDE_HOOK_DEBUG:-0}" = "1" ] || return 0
    echo "[$(date '+%H:%M:%S')] codex-wrapper: $*" >> /tmp/claude-hook.log
}

_resolve_real_codex() {
    local self candidate resolved
    self="$(readlink -f "${BASH_SOURCE[0]:-$0}" 2>/dev/null || printf '%s' "$0")"

    while IFS= read -r candidate; do
        [ -n "$candidate" ] || continue
        resolved="$(readlink -f "$candidate" 2>/dev/null || printf '%s' "$candidate")"
        [ "$resolved" = "$self" ] && continue
        printf '%s\n' "$candidate"
        return 0
    done < <(type -ap codex 2>/dev/null | awk '!seen[$0]++')

    return 1
}

_codex_monitor_script() {
    echo "$HOME/.config/kitty/scripts/codex-event-monitor.py"
}

_codex_target_cwd() {
    local target="${PWD:-$HOME}"
    local expect_value=""
    local arg=""

    for arg in "$@"; do
        if [ -n "$expect_value" ]; then
            target="$arg"
            expect_value=""
            continue
        fi

        case "$arg" in
            -C|--cd)
                expect_value="1"
                ;;
            --cd=*)
                target="${arg#--cd=}"
                ;;
        esac
    done

    if [ -n "$target" ]; then
        python3 - "$target" <<'PY' 2>/dev/null || printf '%s\n' "$target"
import os
import sys

print(os.path.realpath(os.path.expanduser(sys.argv[1])))
PY
    else
        printf '%s\n' "$PWD"
    fi
}

_start_codex_notify_monitor() {
    [ "${KITTY_ENHANCE_CODEX_NOTIFY:-1}" = "1" ] || return 0
    [ -n "${KITTY_WINDOW_ID:-}" ] || return 0
    [ -n "${KITTY_LISTEN_ON:-}" ] || return 0

    local monitor
    monitor="$(_codex_monitor_script)"
    [ -f "$monitor" ] || return 0

    local pidfile="/tmp/kitty-codex-monitor-${KITTY_WINDOW_ID}.pid"
    if [ -f "$pidfile" ]; then
        local old_pid=""
        read -r old_pid < "$pidfile"
        if [ -n "$old_pid" ] && kill -0 "$old_pid" 2>/dev/null; then
            kill "$old_pid" 2>/dev/null || true
        fi
        rm -f "$pidfile"
    fi

    local target_cwd
    target_cwd="$(_codex_target_cwd "$@")"

    debug "start monitor window=${KITTY_WINDOW_ID} socket=${KITTY_LISTEN_ON} cwd=${target_cwd}"
    python3 "$monitor" \
        --window-id "${KITTY_WINDOW_ID}" \
        --kitty-socket "${KITTY_LISTEN_ON}" \
        --cwd "$target_cwd" \
        >/dev/null 2>&1 &
    echo "$!" > "$pidfile"
}

main() {
    local real_codex=""
    real_codex="$(_resolve_real_codex)" || {
        echo "codex wrapper: failed to locate real codex binary" >&2
        exit 127
    }

    debug "exec real_codex=${real_codex} args=$*"
    _start_codex_notify_monitor "$@"
    exec "$real_codex" "$@"
}

main "$@"
